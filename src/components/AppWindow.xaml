<Window x:Class="S2CE.Components.AppWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="S2CE · SAI2 主题" Width="860" Height="730" MinWidth="740" MinHeight="650"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource MainText}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" Loaded="Window_Loaded"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True">
    <Grid Margin="28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,22">
            <StackPanel>
                <TextBlock Text="给 SAI 换个配色" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="选择你使用的 SAI2，生成独立的主题副本。" Foreground="{StaticResource MutedText}" Margin="0,7,0,0"/>
            </StackPanel>
            <TextBlock Name="versionLabel" Foreground="{StaticResource MutedText}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,0,0"/>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <Border Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="1   选择 SAI2" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <Button Name="selectSaiButton" Content="选择程序…" Click="SelectSai_ButtonClicked" HorizontalAlignment="Right" AutomationProperties.Name="选择原版 SAI2 程序"/>
                        </Grid>
                        <TextBlock Name="sourcePathLabel" Text="选择你平时使用的 sai2.exe" Foreground="{StaticResource MutedText}"
                                   Margin="0,14,0,0" TextTrimming="CharacterEllipsis" ToolTipService.ShowDuration="20000"/>
                        <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                            <Border Name="statusBadge" Background="#30383D" CornerRadius="5" Padding="8,3" VerticalAlignment="Top">
                                <TextBlock Name="statusLabel" Text="待选择" FontSize="12"/>
                            </Border>
                            <TextBlock Name="buildLabel" Text="选好后会自动检查是否支持" Foreground="{StaticResource MutedText}" FontSize="13" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Name="sourceHint" Foreground="#E8BA98" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>
                        <Expander Name="detectionExpander" Header="检测详情" Margin="0,12,0,0" Visibility="Collapsed">
                            <StackPanel Margin="3,10,0,0">
                                <TextBlock Name="detectionDetails" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="12"/>
                                <Button Name="refreshSaiButton" Content="重新检测" Click="RefreshSai_ButtonClicked" FontSize="12" Padding="10,5" MinHeight="30" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>

                <Grid Margin="0,24,10,12">
                    <TextBlock Text="2   选择主题" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                    <Button Name="customThemeButton" Content="自定义配色…" HorizontalAlignment="Right" Padding="12,6" MinHeight="34" Click="CustomTheme_Clicked"/>
                </Grid>
                <ListBox Name="themeList" SelectionChanged="Theme_SelectionChanged" MouseDoubleClick="Theme_DoubleClicked" Background="Transparent" Foreground="{StaticResource MainText}" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch" AutomationProperties.Name="主题配色">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,10,10"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="ToolTip" Value="双击编辑配色；内置预设将创建副本。"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Name="Card" Background="{StaticResource Surface}" BorderBrush="{StaticResource Outline}" BorderThickness="2" CornerRadius="12" Padding="13">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#6B7D76"/></Trigger>
                                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border CornerRadius="6" Background="{Binding Primary}" Padding="6" Height="96" ClipToBounds="True">
                                    <Grid>
                                        <Grid.RowDefinitions><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                        <Border Background="{Binding Ternary}" CornerRadius="2"/>
                                        <Grid Grid.Row="1" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Border Background="{Binding Secondary}" CornerRadius="3">
                                                <StackPanel Margin="5,6">
                                                    <Border Background="{Binding Selection}" Height="7" CornerRadius="2"/>
                                                    <Border Background="{Binding Ternary}" Height="7" CornerRadius="2" Margin="0,5,0,0"/>
                                                    <Border Background="{Binding Ternary}" Height="7" CornerRadius="2" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                            <Border Grid.Column="1" Background="#FAF8F3" Margin="12,5,7,5" CornerRadius="2">
                                                <Viewbox Stretch="Uniform">
                                                    <Canvas Width="150" Height="52">
                                                        <Path Data="M 18,30 C 40,4 58,46 84,20 S 116,14 133,23" Stroke="{Binding Primary}" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                        <Path Data="M 40,42 C 66,24 86,46 110,34" Stroke="{Binding Selection}" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="16" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Grid.Column="1" Text="✓ 已选择" Foreground="{StaticResource Accent}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Name="themeHint" Text="上方为配色示意，应用后在 SAI 中查看实际效果。" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,16"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0" Padding="0,18,0,0" Margin="0,12,0,0">
            <StackPanel>
                <ProgressBar Name="busyProgress" IsIndeterminate="True" Height="3" Foreground="{StaticResource Accent}" Background="{StaticResource Outline}" Visibility="Collapsed" Margin="0,0,0,10"/>
                <TextBlock Name="operationMessage" Text="先关闭正在运行的 SAI。原版程序和配置会保留。" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" FontSize="13" Margin="0,0,0,12"/>
                <Grid>
                    <Button Name="restoreButton" Content="恢复原版并启动" Click="Restore_ButtonClicked" HorizontalAlignment="Left" Visibility="Collapsed"
                            ToolTip="清理本工具生成的主题副本，再启动原版 SAI。"/>
                    <Button Name="launchButton" Content="请先选择 SAI2" Style="{StaticResource PrimaryButton}" Click="Launch_ButtonClicked" HorizontalAlignment="Right" MinWidth="220" IsEnabled="False"/>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
