<Window x:Class="S2CE.Components.ThemeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义主题配色" Width="820" Height="700" MinWidth="760" MinHeight="640"
        Background="{StaticResource AppBackground}" Foreground="{StaticResource MainText}"
        FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#14181B"/>
            <Setter Property="Foreground" Value="{StaticResource MainText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Outline}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="SelectionBrush" Value="#486458"/>
            <Setter Property="SelectionTextBrush" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{StaticResource Accent}"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="调出你喜欢的配色" FontSize="23" FontWeight="SemiBold"/>
            <TextBlock Text="6 组界面色，可点击色块选色，或输入 #RRGGBB。" Foreground="{StaticResource MutedText}" Margin="0,7,0,0"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,5,0">
                <TextBlock Text="主题名称" Margin="0,0,0,7"/>
                <TextBox Name="nameInput" MaxLength="80" TextChanged="Name_Changed" AutomationProperties.Name="主题名称"/>
                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <ItemsControl Name="colorFields">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Hint}" VerticalAlignment="Center" Foreground="{StaticResource MainText}"/>
                                        <Button Grid.Column="1" Click="PickColor_Clicked" Padding="4" MinHeight="35" Margin="0,0,8,0" ToolTip="点击选择颜色" AutomationProperties.Name="{Binding Name}">
                                            <Border Background="{Binding PreviewBrush}" Width="23" Height="23" CornerRadius="3"/>
                                        </Button>
                                        <TextBox Grid.Column="2" Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" FontFamily="Consolas" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Name}">
                                            <TextBox.Style>
                                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="BorderBrush" Value="#E8BA98"/></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBox.Style>
                                        </TextBox>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <CheckBox Name="colorCircle" Content="色环背景也跟随主题" Foreground="{StaticResource MainText}" Margin="0,8,0,0" Checked="Circle_Changed" Unchecked="Circle_Changed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="实时配色示意" Foreground="{StaticResource MutedText}" Margin="0,0,0,10"/>
                        <Border Name="previewRoot" Background="{Binding [Primary]}" CornerRadius="9" Padding="12" Height="260">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="42"/></Grid.RowDefinitions>
                                <Border Background="{Binding [Secondary]}" CornerRadius="4" Padding="8,4">
                                    <TextBlock Text="SAI2   画笔 · 图层" Foreground="{Binding [Text]}" VerticalAlignment="Center" FontSize="12"/>
                                </Border>
                                <Grid Grid.Row="1" Margin="0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="64"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Background="{Binding [Ternary]}" CornerRadius="4" Padding="5">
                                        <StackPanel>
                                            <Border Background="{Binding [SelectablePrimary]}" CornerRadius="3" Padding="4" Margin="0,0,0,5"><TextBlock Text="铅笔" Foreground="{Binding [Text]}" FontSize="12"/></Border>
                                            <TextBlock Text="喷枪" Foreground="{Binding [Text]}" FontSize="12" Margin="4,4"/>
                                            <TextBlock Text="画笔" Foreground="{Binding [Text]}" FontSize="12" Margin="4,4"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Background="#FAF8F3" CornerRadius="3" Margin="9,7,0,7">
                                        <Viewbox>
                                            <Canvas Width="140" Height="120">
                                                <Path Data="M 17,42 C 48,6 60,76 120,39" Stroke="#262626" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                                <Path Data="M 22,81 C 65,45 76,107 116,77" Stroke="#C96052" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                </Grid>
                                <Border Grid.Row="2" Background="{Binding [SelectableSecondary]}" CornerRadius="4" Padding="8">
                                    <TextBlock Text="图层 1       100%" Foreground="{Binding [Text]}" FontSize="12" VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <TextBlock Text="示意图用于对照配色，实际效果请在 SAI 中查看。" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>
                <TextBlock Name="validationHint" TextWrapping="Wrap" Foreground="#E8BA98" Margin="0,12,0,0"/>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" BorderBrush="{StaticResource Outline}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Name="saveHint" Text="另存为新主题，当前主题会保留。" Foreground="{StaticResource MutedText}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Name="saveAsButton" Content="另存为…" Click="SaveAs_Clicked" Visibility="Collapsed" Margin="0,0,10,0"/>
                    <Button Content="取消" IsCancel="True" Margin="0,0,10,0"/>
                    <Button Name="saveThemeButton" Content="保存主题" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="SaveTheme_Clicked" IsEnabled="False"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
