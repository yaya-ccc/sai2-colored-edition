<Window x:Class="S2CE.Components.ThemeEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="主题工作室" Width="1200" Height="820" MinWidth="960" MinHeight="680" Background="{StaticResource AppBackground}" Foreground="{StaticResource MainText}" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="14" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#14181B"/><Setter Property="Foreground" Value="{StaticResource MainText}"/><Setter Property="BorderBrush" Value="{StaticResource Outline}"/><Setter Property="Padding" Value="8,6"/><Setter Property="SelectionBrush" Value="#486458"/></Style>
 </Window.Resources>
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,20"><TextBlock Text="主题工作室" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="选一种界面颜色，边调边看。" Foreground="{StaticResource MutedText}" Margin="0,6,0,0"/></StackPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0">
    <TextBlock Text="主题名称" Margin="0,0,0,6"/><TextBox Name="nameInput" MaxLength="80" TextChanged="Name_Changed"/>
    <ItemsControl Name="colorFields" Margin="0,18,0,12"><ItemsControl.ItemTemplate><DataTemplate>
     <Grid Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="108"/></Grid.ColumnDefinitions>
      <Button Click="PickColor_Clicked" Padding="8,5" HorizontalContentAlignment="Left" ToolTip="{Binding Hint}"><StackPanel Orientation="Horizontal"><Border Background="{Binding PreviewBrush}" Width="22" Height="22" CornerRadius="5" Margin="0,0,10,0"/><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/></StackPanel></Button>
      <TextBox Grid.Column="1" Text="{Binding HexText, UpdateSourceTrigger=PropertyChanged}" MaxLength="7" FontFamily="Consolas" Margin="8,0,0,0" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding Name}"/>
     </Grid>
    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="12"><StackPanel>
     <TextBlock Name="activeColorLabel" FontWeight="SemiBold" Margin="0,0,0,10"/>
     <Grid Name="colorPad" Height="150" Cursor="Cross" MouseLeftButtonDown="Pad_Down" MouseMove="Pad_Move" MouseLeftButtonUp="Pad_Up" SizeChanged="Pad_SizeChanged">
      <Border Name="hueBase" Background="Red"/>
      <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="White" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <Border><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#00000000" Offset="0"/><GradientStop Color="Black" Offset="1"/></LinearGradientBrush></Border.Background></Border>
      <Canvas IsHitTestVisible="False" ClipToBounds="True"><Ellipse Name="colorMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2" Fill="Transparent"/></Canvas>
     </Grid>
     <TextBlock Text="色相" Foreground="{StaticResource MutedText}" Margin="0,10,0,4"/>
     <Slider Name="hueSlider" Minimum="0" Maximum="359" ValueChanged="Hue_Changed" AutomationProperties.Name="色相"/>
     <TextBlock Text="饱和度" Foreground="{StaticResource MutedText}" Margin="0,6,0,0"/><Slider Name="saturationSlider" Minimum="0" Maximum="1" SmallChange="0.01" ValueChanged="Sv_Changed" AutomationProperties.Name="饱和度"/>
     <TextBlock Text="明度" Foreground="{StaticResource MutedText}" Margin="0,6,0,0"/><Slider Name="valueSlider" Minimum="0" Maximum="1" SmallChange="0.01" ValueChanged="Sv_Changed" AutomationProperties.Name="明度"/>
    </StackPanel></Border>
    <CheckBox Name="colorCircle" Content="色环背景跟随主题（生成时应用）" Foreground="{StaticResource MainText}" Margin="0,14,0,0" Checked="Circle_Changed" Unchecked="Circle_Changed"/>
    <TextBlock Name="validationHint" Foreground="#E8BA98" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel></ScrollViewer>
   <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12"><CheckBox Name="actualSize" DockPanel.Dock="Right" Content="原始大小" Foreground="{StaticResource MainText}" Checked="Zoom_Changed" Unchecked="Zoom_Changed"/><TextBlock Text="SAI2 · 实时配色预览" FontWeight="SemiBold" FontSize="17"/></DockPanel>
    <Border Grid.Row="1" Background="#252B30" CornerRadius="12" Padding="12"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"><Image Name="previewImage" Stretch="Uniform" VerticalAlignment="Center"><Image.Style><Style TargetType="Image"><Setter Property="Width" Value="{Binding ViewportWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"/><Style.Triggers><DataTrigger Binding="{Binding IsChecked, ElementName=actualSize}" Value="True"><Setter Property="Width" Value="Auto"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></ScrollViewer></Border>
    <TextBlock Grid.Row="2" Text="基于真实 SAI2 截图换色；画布与色环保持原样。细节可能与实际运行略有差异，保存后生成主题即可应用。" TextWrapping="Wrap" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,12,0,0"/>
   </Grid>
  </Grid>
  <DockPanel Grid.Row="2" Margin="0,18,0,0"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Name="saveAsButton" Content="另存为…" Click="SaveAs_Clicked" Visibility="Collapsed" Margin="0,0,8,0"/><Button Content="取消" IsCancel="True" Margin="0,0,8,0"/><Button Name="saveThemeButton" Content="保存主题" Style="{StaticResource PrimaryButton}" Click="SaveTheme_Clicked" IsEnabled="False"/></StackPanel><TextBlock Name="saveHint" Text="另存为新主题，当前主题会保留。" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0"/></DockPanel>
 </Grid>
</Window>
