<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/MainTheme.cs" Link="MainTheme.cs" />
    <Compile Include="../../src/tools/*.cs" Link="tools/%(Filename)%(Extension)" />
    <Compile Include="../../src/extensions/*.cs" Link="extensions/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
